doctype html
html 
    head 
        title= title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body    
        h1 Custom Objects Table
        p
            a(href="/update-cobj") Add to this table
        table
            thead
                tr
                    th Name
                    th Game
                    th Platform
            tbody
                each item in data
                    tr
                        td #{item.properties.name}
                        td #{item.properties.game}
                        td #{item.properties.platform}